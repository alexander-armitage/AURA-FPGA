	(text "RT: 1MHz\nCFG1: 4A, 4A, 2A, 2A\nCFG2: Sequnce, 1x, FPWM, UVO\nEN3/UV: 3V9 cut-off\nEN2/DL12: 2ms (soft start), 6ms\nEN4/DL34: 12ms, 12ms"
		(exclude_from_sim no)
